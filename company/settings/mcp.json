{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false,
      "autoApprove": []
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp",
      "disabled": false,
      "autoApprove": []
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "{{connectors.slack.clientId}}",
        "redirectUri": "http://127.0.0.1:{{connectors.slack.redirectPort}}/oauth/callback"
      },
      "disabled": true,
      "autoApprove": []
    },
    "microsoft365": {
      "command": "npx",
      "args": [
        "-y",
        "@softeria/ms-365-mcp-server@0.179.1",
        "--org-mode",
        "--preset",
        "calendar,excel,files"
      ],
      "env": {
        "MS365_MCP_CLIENT_ID": "{{connectors.microsoft365.clientId}}",
        "MS365_MCP_TENANT_ID": "{{connectors.microsoft365.tenantId}}"
      },
      "disabled": true,
      "autoApprove": []
    }
  }
}
